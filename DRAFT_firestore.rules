rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data, userId) {
      return data.uid is string &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.email is string &&
        data.email.size() <= 256 &&
        (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
        (!('createdAt' in data) || data.createdAt is string) &&
        (!('updatedAt' in data) || data.updatedAt is string);
    }

    function isValidFinancialData(data, userId) {
      return data.userId is string &&
        data.userId == userId &&
        data.userId == request.auth.uid &&
        data.updatedAt is string &&
        (!('incomes' in data) || data.incomes is list) &&
        (!('expenses' in data) || data.expenses is list) &&
        (!('budgetConfig' in data) || data.budgetConfig is map) &&
        (!('savingsGoals' in data) || data.savingsGoals is list) &&
        (!('debts' in data) || data.debts is list) &&
        (!('netWorthItems' in data) || data.netWorthItems is list) &&
        (!('selectedMonth' in data) || (data.selectedMonth is string && data.selectedMonth.size() <= 16)) &&
        (!('monthlyReviewNotes' in data) || data.monthlyReviewNotes is map) &&
        (!('theme' in data) || (data.theme is string && data.theme.size() <= 16));
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Users cannot be listed
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming(), userId) && incoming().uid == existing().uid;
      allow delete: if isOwner(userId) && isValidId(userId);

      match /financialData/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(docId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(docId) && isValidFinancialData(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(docId) && isValidFinancialData(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(docId);
      }
    }
  }
}
